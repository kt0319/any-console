#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

SERVICE_NAME="any-console"

error() { echo -e "${RED}Error: $1${NC}" >&2; exit 1; }
info()  { echo -e "${GREEN}$1${NC}"; }
warn()  { echo -e "${YELLOW}$1${NC}"; }

check_deps() {
  local missing=()
  for cmd in python3 node git tmux; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done

  if [ ${#missing[@]} -gt 0 ]; then
    echo ""
    echo -e "${RED}Missing commands: ${missing[*]}${NC}" >&2
    echo ""
    echo "Install examples:"
    echo "  Debian/Ubuntu: sudo apt install ${missing[*]}"
    echo "  macOS:         brew install ${missing[*]}"
    exit 1
  fi
}

check_python_version() {
  local python_version
  python_version=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
  local python_major python_minor
  python_major=$(echo "$python_version" | cut -d. -f1)
  python_minor=$(echo "$python_version" | cut -d. -f2)
  if [ "$python_major" -lt 3 ] || { [ "$python_major" -eq 3 ] && [ "$python_minor" -lt 11 ]; }; then
    error "Python 3.11+ required (current: $python_version)"
  fi
  echo "$python_version"
}

get_version() {
  git log -1 --format='%h %cd' --date=format:'%Y-%m-%d %H:%M' 2>/dev/null || echo "unknown"
}

get_port() {
  python3 -c "
import json, pathlib
p = pathlib.Path('config.json')
if not p.is_file():
    print(8888); exit()
try:
    cfg = json.loads(p.read_text())
    print(cfg.get('__global__', {}).get('port') or 8888)
except Exception:
    print(8888)
" 2>/dev/null
}

get_host() {
  python3 -c "
import json, pathlib
p = pathlib.Path('config.json')
if not p.is_file():
    print('0.0.0.0'); exit()
try:
    cfg = json.loads(p.read_text())
    print(cfg.get('__global__', {}).get('host') or '0.0.0.0')
except Exception:
    print('0.0.0.0')
" 2>/dev/null
}

prompt_bind_config() {
  local current_host current_port new_host new_port
  current_host=$(get_host)
  current_port=$(get_port)

  read -rp "Bind host [${current_host}]: " new_host
  new_host=${new_host:-$current_host}
  read -rp "Port [${current_port}]: " new_port
  new_port=${new_port:-$current_port}

  HOST="$new_host" PORT="$new_port" python3 -c "
import json, os, pathlib
p = pathlib.Path('config.json')
cfg = json.loads(p.read_text()) if p.is_file() else {}
g = cfg.get('__global__', {})
if not isinstance(g, dict):
    g = {}
g['host'] = os.environ['HOST']
g['port'] = int(os.environ['PORT'])
cfg['__global__'] = g
p.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
"
  info "Saved to config.json (host=${new_host}, port=${new_port})"
}

prompt_initial_workspace() {
  local ws_path
  read -rp "Initial workspace path (leave blank to skip): " ws_path
  if [ -z "$ws_path" ]; then
    return 0
  fi
  WS_PATH="$ws_path" python3 -c "
import json, os, pathlib, sys
p = pathlib.Path('config.json')
cfg = json.loads(p.read_text()) if p.is_file() else {}
abs_path = pathlib.Path(os.path.expanduser(os.environ['WS_PATH'])).resolve()
if not abs_path.is_dir():
    print(f'Directory does not exist: {abs_path}', file=sys.stderr)
    sys.exit(1)
name = abs_path.name
if name in cfg and name != '__global__':
    print(f'Already registered: {name}', file=sys.stderr)
    sys.exit(1)
cfg[name] = {'path': str(abs_path)}
p.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
print(f'Registered: {name} ({abs_path})')
" || warn "Skipped workspace registration"
}

is_service_active() {
  systemctl is-active "$SERVICE_NAME" >/dev/null 2>&1
}

is_service_installed() {
  systemctl list-unit-files "$SERVICE_NAME.service" >/dev/null 2>&1 && \
    [ -f "/etc/systemd/system/$SERVICE_NAME.service" ]
}

cmd_setup() {
  info "=== any-console setup ==="

  check_deps

  local python_version
  python_version=$(check_python_version)
  info "Dependencies OK: Python $python_version, node $(node -v), git $(git --version | cut -d' ' -f3), tmux $(tmux -V | cut -d' ' -f2)"

  info "Installing Python dependencies..."
  pip install -r requirements.txt

  info "Installing Node.js dependencies..."
  npm install

  info "Building frontend..."
  npm run build

  echo ""
  info "Bind config (saved under __global__ in config.json)"
  prompt_bind_config

  echo ""
  info "Initial workspace registration"
  prompt_initial_workspace

  echo ""
  read -rp "Register a systemd service? [y/N] " answer
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    install_systemd
  fi

  echo ""
  info "=== Setup complete ==="
  echo ""
  echo "Start:"
  echo "  ./any-console start    (if systemd is registered)"
  echo "  ./any-console run      (foreground, no systemd; macOS/WSL/etc.)"
  echo ""
  echo "Open http://localhost:$(get_port) in your browser."
  echo "If an auth token is required, issue one from UI > Security."
}

generate_service_unit() {
  cat <<UNIT
[Unit]
Description=any-console API
After=network.target

[Service]
User=$USER
WorkingDirectory=$SCRIPT_DIR
ExecStart=/usr/bin/python3 -m api.main
KillMode=process
Restart=always
RestartSec=3
NoNewPrivileges=no
ProtectSystem=no
ProtectHome=no
MemoryMax=8G
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
UNIT
}

install_systemd() {
  local service_dest="/etc/systemd/system/$SERVICE_NAME.service"

  info "Registering systemd service..."
  generate_service_unit | sudo tee "$service_dest" > /dev/null
  sudo systemctl daemon-reload
  sudo systemctl enable "$SERVICE_NAME"
  info "systemd service registered"
}

cmd_update() {
  info "=== any-console update ==="

  if [ -n "$(git status --porcelain)" ]; then
    error "Uncommitted changes present. Commit or stash first."
  fi

  local before_hash
  before_hash=$(git rev-parse HEAD)

  info "Fetching latest..."
  git pull --ff-only

  local after_hash
  after_hash=$(git rev-parse HEAD)

  if [ "$before_hash" = "$after_hash" ]; then
    info "Already up to date ($(get_version))"
    return
  fi

  info "Updating dependencies..."
  pip install -r requirements.txt
  npm install

  info "Building frontend..."
  npm run build

  if is_service_active; then
    info "Restarting service..."
    sudo systemctl restart "$SERVICE_NAME"
    info "Service restarted"
  fi

  info "=== Update complete ($(get_version)) ==="
}

cmd_start() {
  sudo systemctl start "$SERVICE_NAME"
  info "Service started"
}

cmd_stop() {
  sudo systemctl stop "$SERVICE_NAME"
  info "Service stopped"
}

cmd_restart() {
  sudo systemctl restart "$SERVICE_NAME"
  info "Service restarted"
}

cmd_status() {
  echo -e "${BOLD}any-console${NC}"
  echo ""

  echo -n "  Service: "
  if is_service_installed; then
    if is_service_active; then
      echo -e "${GREEN}running${NC}"
    else
      echo -e "${RED}stopped${NC}"
    fi
  else
    echo -e "${YELLOW}not registered${NC}"
  fi

  echo "  Version: $(get_version)"
  echo "  URL: http://localhost:$(get_port)"
  echo "  Directory: $SCRIPT_DIR"
}

cmd_logs() {
  journalctl -u "$SERVICE_NAME" -f --no-pager -n 50
}

cmd_run() {
  check_deps
  check_python_version >/dev/null
  info "Starting any-console in the foreground (Ctrl+C to stop)"
  echo "  URL: http://localhost:$(get_port)"
  exec python3 -m api.main
}

cmd_version() {
  echo "any-console $(get_version)"
}

usage() {
  echo -e "${BOLD}Usage:${NC} ./any-console <command>"
  echo ""
  echo "Commands:"
  echo "  setup      Initial setup (install deps + build + optional systemd register)"
  echo "  update     Update to latest (git pull + deps + build + service restart)"
  echo "  start      Start service (systemd)"
  echo "  stop       Stop service (systemd)"
  echo "  restart    Restart service (systemd)"
  echo "  status     Show service state, URL, version"
  echo "  logs       Tail service logs (journalctl)"
  echo "  run        Run in foreground (no systemd; macOS/WSL/etc.)"
  echo "  version    Print version"
}

command="${1:-}"

case "$command" in
  setup)   cmd_setup ;;
  update)  cmd_update ;;
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  logs)    cmd_logs ;;
  run)     cmd_run ;;
  version) cmd_version ;;
  *)       usage ;;
esac
