#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

SERVICE_NAME="any-console"

# OS 判定。Linux は systemd、macOS (Darwin) は launchd で常駐サービスを管理する。
OS_NAME="$(uname -s)"
is_macos() { [ "$OS_NAME" = "Darwin" ]; }

# macOS: LaunchAgent として登録する（ユーザーログイン後に常駐）。
# LaunchDaemon（system 域）はユーザーホームへのアクセスを macOS が制限するため、
# ユーザー域で実行する LaunchAgent を使う。sudo 不要。
LAUNCHD_LABEL="net.highedge.any-console"
LAUNCHD_PLIST="$HOME/Library/LaunchAgents/$LAUNCHD_LABEL.plist"
# journalctl が無いため stdout/stderr はログファイルへ出す。
LOG_FILE="$SCRIPT_DIR/logs/$SERVICE_NAME.log"

# Python 依存はシステムを汚さないよう専用 venv に隔離する（externally-managed
# 環境での pip エラー回避と再現性のため）。サービス起動も venv の python を使う。
VENV_DIR="$SCRIPT_DIR/.venv"

error() { echo -e "${RED}Error: $1${NC}" >&2; exit 1; }
info()  { echo -e "${GREEN}$1${NC}"; }
warn()  { echo -e "${YELLOW}$1${NC}"; }

# アプリ実行に使う python を返す。venv があればそれを、無ければシステム python3。
venv_python() {
  if [ -x "$VENV_DIR/bin/python3" ]; then
    echo "$VENV_DIR/bin/python3"
  else
    command -v python3
  fi
}

# 利用可能なパッケージマネージャを1つ返す（無ければ空文字）。
detect_pkg_manager() {
  if is_macos; then
    command -v brew >/dev/null 2>&1 && { echo "brew"; return; }
  else
    local m
    for m in apt-get dnf yum pacman zypper apk; do
      command -v "$m" >/dev/null 2>&1 && { echo "$m"; return; }
    done
  fi
  echo ""
}

# コマンド名をパッケージマネージャ別のパッケージ名に変換する。
_pkg_name() {
  # $1 = manager, $2 = command
  case "$2" in
    node)
      case "$1" in
        apt-get) echo "nodejs" ;;
        *)       echo "node" ;;
      esac ;;
    python3)
      case "$1" in
        brew) echo "python" ;;
        *)    echo "python3" ;;
      esac ;;
    *) echo "$2" ;;
  esac
}

# 指定マネージャで不足コマンドを入れるインストールコマンド文字列を組み立てる。
install_cmd_for() {
  local mgr="$1"; shift
  local pkgs=() c
  for c in "$@"; do pkgs+=("$(_pkg_name "$mgr" "$c")"); done
  case "$mgr" in
    brew)    echo "brew install ${pkgs[*]}" ;;
    apt-get) echo "sudo apt-get install -y ${pkgs[*]}" ;;
    dnf)     echo "sudo dnf install -y ${pkgs[*]}" ;;
    yum)     echo "sudo yum install -y ${pkgs[*]}" ;;
    pacman)  echo "sudo pacman -S --noconfirm ${pkgs[*]}" ;;
    zypper)  echo "sudo zypper install -y ${pkgs[*]}" ;;
    apk)     echo "sudo apk add ${pkgs[*]}" ;;
    *)       echo "" ;;
  esac
}

check_deps() {
  local missing=() cmd
  for cmd in python3 node git tmux; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done
  [ ${#missing[@]} -eq 0 ] && return

  echo ""
  echo -e "${RED}Missing commands: ${missing[*]}${NC}" >&2

  local mgr cmd_line answer still
  mgr="$(detect_pkg_manager)"
  cmd_line="$(install_cmd_for "$mgr" "${missing[@]}")"

  # 対話 TTY かつ対応マネージャを検出できた場合だけ、同意制で自動インストールを提案する。
  if [ -n "$cmd_line" ] && [ -t 0 ]; then
    echo ""
    echo "Detected package manager: $mgr"
    echo "  $cmd_line"
    echo ""
    read -rp "Install the missing dependencies now? [y/N] " answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      if eval "$cmd_line"; then
        still=()
        for cmd in "${missing[@]}"; do
          command -v "$cmd" >/dev/null 2>&1 || still+=("$cmd")
        done
        if [ ${#still[@]} -eq 0 ]; then
          info "Dependencies installed."
          return
        fi
        error "Still missing after install: ${still[*]} — install manually: $cmd_line"
      fi
      error "Automatic install failed. Install manually: $cmd_line"
    fi
    error "Dependencies required. Install with: $cmd_line"
  fi

  # 非対話 or 未対応マネージャ: 手順を提示して終了する。
  echo ""
  echo "Install examples:"
  echo "  Debian/Ubuntu: $(install_cmd_for apt-get "${missing[@]}")"
  echo "  macOS:         $(install_cmd_for brew "${missing[@]}")"
  exit 1
}

check_python_version() {
  local python_version
  python_version=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
  local python_major python_minor
  python_major=$(echo "$python_version" | cut -d. -f1)
  python_minor=$(echo "$python_version" | cut -d. -f2)
  if [ "$python_major" -lt 3 ] || { [ "$python_major" -eq 3 ] && [ "$python_minor" -lt 11 ]; }; then
    error "Python 3.11+ required (current: $python_version)"
  fi
  echo "$python_version"
}

get_version() {
  git log -1 --format='%h %cd' --date=format:'%Y-%m-%d %H:%M' 2>/dev/null || echo "unknown"
}

# ANY_CONSOLE_DATA_DIR 設定時は config.json もそのディレクトリ配下に置かれる
# （api/common.py の resolve_data_paths と同じ規則）。以下の各 python スニペットも同様。
get_port() {
  python3 -c "
import json, os, pathlib
d = os.environ.get('ANY_CONSOLE_DATA_DIR', '').strip()
p = pathlib.Path(d).expanduser() / 'config.json' if d else pathlib.Path('config.json')
if not p.is_file():
    print(8888); exit()
try:
    cfg = json.loads(p.read_text())
    print(cfg.get('__global__', {}).get('port') or 8888)
except Exception:
    print(8888)
" 2>/dev/null
}

get_host() {
  python3 -c "
import json, os, pathlib
d = os.environ.get('ANY_CONSOLE_DATA_DIR', '').strip()
p = pathlib.Path(d).expanduser() / 'config.json' if d else pathlib.Path('config.json')
if not p.is_file():
    print('0.0.0.0'); exit()
try:
    cfg = json.loads(p.read_text())
    print(cfg.get('__global__', {}).get('host') or '0.0.0.0')
except Exception:
    print('0.0.0.0')
" 2>/dev/null
}

get_config_value() {
  KEY="$1" python3 -c "
import json, os, pathlib
d = os.environ.get('ANY_CONSOLE_DATA_DIR', '').strip()
p = pathlib.Path(d).expanduser() / 'config.json' if d else pathlib.Path('config.json')
if not p.is_file():
    print(''); exit()
try:
    cfg = json.loads(p.read_text())
    print(cfg.get('__global__', {}).get(os.environ['KEY'], '') or '')
except Exception:
    print('')
" 2>/dev/null
}

get_ssl_certfile() { get_config_value 'ssl_certfile'; }
get_ssl_keyfile()  { get_config_value 'ssl_keyfile'; }

has_https() {
  [ -n "$(get_ssl_certfile)" ] && [ -n "$(get_ssl_keyfile)" ]
}

prompt_bind_config() {
  local current_host current_port new_host new_port
  current_host=$(get_host)
  current_port=$(get_port)

  echo "  - 0.0.0.0   : listen on all interfaces (LAN / Tailscale reachable)"
  echo "  - 127.0.0.1 : localhost only"
  echo ""
  read -rp "Bind host [${current_host}]: " new_host
  new_host=${new_host:-$current_host}
  read -rp "Port [${current_port}]: " new_port
  new_port=${new_port:-$current_port}

  HOST="$new_host" PORT="$new_port" python3 -c "
import json, os, pathlib
d = os.environ.get('ANY_CONSOLE_DATA_DIR', '').strip()
p = pathlib.Path(d).expanduser() / 'config.json' if d else pathlib.Path('config.json')
cfg = json.loads(p.read_text()) if p.is_file() else {}
g = cfg.get('__global__', {})
if not isinstance(g, dict):
    g = {}
g['host'] = os.environ['HOST']
g['port'] = int(os.environ['PORT'])
cfg['__global__'] = g
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
"
  info "Saved to config.json (host=${new_host}, port=${new_port})"
}

# よくある開発ディレクトリを走査して git リポジトリのパス一覧を返す（1行1パス）。
discover_git_repos() {
  python3 - <<'PY'
import os, pathlib

home = pathlib.Path.home()
# (root, max_depth): dev 系は深め、HOME 直下は浅めに留めて高速化する。
roots: list[tuple[pathlib.Path, int]] = []
for name in ("ghq", "src", "code", "repos", "projects", "dev", "Developer",
             "git", "work", "go/src"):
    d = home / name
    if d.is_dir():
        roots.append((d, 4))
roots.append((home, 2))

SKIP = {"node_modules", "__pycache__", "venv", ".venv", "dist", "build",
        "vendor", "target", ".cache", "Library", "go"}
LIMIT = 40
found: dict[pathlib.Path, bool] = {}


def scan(root: pathlib.Path, max_depth: int) -> None:
    root = root.resolve()
    for dirpath, dirnames, filenames in os.walk(root, onerror=lambda e: None):
        if len(found) >= LIMIT:
            dirnames[:] = []
            return
        cur = pathlib.Path(dirpath)
        depth = len(cur.relative_to(root).parts)
        if ".git" in dirnames or ".git" in filenames:
            found[cur.resolve()] = True
            dirnames[:] = []  # リポジトリ内へは降りない
            continue
        if depth >= max_depth:
            dirnames[:] = []
            continue
        dirnames[:] = [d for d in dirnames if d not in SKIP and not d.startswith(".")]


for r, d in roots:
    if len(found) >= LIMIT:
        break
    scan(r, d)

for p in sorted(found, key=lambda p: str(p).lower()):
    print(p)
PY
}

# 改行区切りのパス群をワークスペースとして登録する（パス重複・名前衝突を解決）。
register_workspace_paths() {
  WS_PATHS="$1" python3 - <<'PY'
import json, os, pathlib

raw = os.environ.get("WS_PATHS", "")
paths = [ln.strip() for ln in raw.splitlines() if ln.strip()]
d = os.environ.get("ANY_CONSOLE_DATA_DIR", "").strip()
p = pathlib.Path(d).expanduser() / "config.json" if d else pathlib.Path("config.json")
cfg = json.loads(p.read_text()) if p.is_file() else {}

existing = {
    pathlib.Path(v["path"]).resolve()
    for k, v in cfg.items()
    if k != "__global__" and isinstance(v, dict) and v.get("path")
}
added = []
for raw_path in paths:
    ap = pathlib.Path(os.path.expanduser(raw_path)).resolve()
    if not ap.is_dir() or ap in existing:
        continue
    base = ap.name or "workspace"
    name, i = base, 2
    while name in cfg and name != "__global__":
        name, i = f"{base}-{i}", i + 1
    cfg[name] = {"path": str(ap)}
    existing.add(ap)
    added.append(name)

if added:
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    for n in added:
        print(f"Registered: {n}")
else:
    print("No new workspaces registered")
PY
}

prompt_manual_workspace() {
  local ws_path
  read -rp "  Workspace path (leave blank to skip): " ws_path
  [ -z "$ws_path" ] && { info "  Skipped (add workspaces from the UI later)"; return 0; }
  register_workspace_paths "$ws_path"
}

# インストール済みのAIエージェントCLIを検知し、未登録なら common job として自動登録する。
# 対話モードでは検出したツールをデフォルト全チェック済みで提示し、番号指定で解除できる。
# 既に同じ command のジョブが登録済みなら二重登録しない（setup 再実行でも安全）。
register_ai_agent_jobs() {
  local non_interactive="${1:-0}"
  local -a detected=()
  local tool
  for tool in claude codex gemini copilot opencode; do
    command -v "$tool" >/dev/null 2>&1 && detected+=("$tool")
  done
  [ ${#detected[@]} -eq 0 ] && { info "  No AI agent CLI tools detected (claude/codex/gemini/copilot/opencode)"; return 0; }

  local -a selected=("${detected[@]}")

  if [ "$non_interactive" -ne 1 ]; then
    echo "  Detected AI agent CLI tools (checked = will be registered as a common job):"
    local i
    for i in "${!detected[@]}"; do
      printf "    [x] %2d) %s\n" "$((i + 1))" "${detected[$i]}"
    done
    echo ""
    local sel
    read -rp "  Register all, or type numbers to exclude (e.g. 2 4), or [n]one: " sel
    case "$sel" in
      ""|[Yy])
        : ;;
      [Nn])
        selected=() ;;
      *)
        local -a exclude=()
        local tok
        for tok in $sel; do
          if [[ "$tok" =~ ^[0-9]+$ ]] && [ "$tok" -ge 1 ] && [ "$tok" -le "${#detected[@]}" ]; then
            exclude+=("${detected[$((tok - 1))]}")
          fi
        done
        selected=()
        for tool in "${detected[@]}"; do
          local skip=0 ex
          for ex in "${exclude[@]}"; do
            [ "$ex" = "$tool" ] && skip=1
          done
          [ "$skip" -eq 0 ] && selected+=("$tool")
        done
        ;;
    esac
  fi

  [ ${#selected[@]} -eq 0 ] && { info "  Skipped (no AI agent jobs registered)"; return 0; }

  AI_TOOLS="$(printf '%s\n' "${selected[@]}")" python3 - <<'PY'
import json, os, pathlib

# notify_phrase: エージェントの承認待ちプロンプトに現れる文字列。合致した約1分後にプッシュ通知する。
# 確度の高いものだけ入れてある（不正確な文字列は「設定した気になって実は一生鳴らない」方が
# 空欄より害があるため）。claude/codex 以外は実際のプロンプト文言が分かり次第補う想定。
TOOL_META = {
    "claude":   {"label": "Claude Code",     "icon": "mdi-robot-outline", "icon_color": "#d97757", "notify_phrase": "1. Yes"},
    "codex":    {"label": "Codex",           "icon": "mdi-robot-outline", "icon_color": "#10a37f", "notify_phrase": "1. Yes"},
    "gemini":   {"label": "Gemini CLI",      "icon": "mdi-robot-outline", "icon_color": "#4285f4", "notify_phrase": ""},
    "copilot":  {"label": "GitHub Copilot",  "icon": "mdi-robot-outline", "icon_color": "#8957e5", "notify_phrase": "1. Yes"},
    "opencode": {"label": "opencode",        "icon": "mdi-robot-outline", "icon_color": "#fab283", "notify_phrase": ""},
}

tools = [t.strip() for t in os.environ.get("AI_TOOLS", "").splitlines() if t.strip()]
d = os.environ.get("ANY_CONSOLE_DATA_DIR", "").strip()
p = pathlib.Path(d).expanduser() / "config.json" if d else pathlib.Path("config.json")
cfg = json.loads(p.read_text()) if p.is_file() else {}
g = cfg.get("__global__", {})
if not isinstance(g, dict):
    g = {}
jobs = g.get("jobs", {})
if not isinstance(jobs, dict):
    jobs = {}

existing_commands = {v.get("command") for v in jobs.values() if isinstance(v, dict)}

added = []
for cmd in tools:
    meta = TOOL_META.get(cmd)
    if not meta or cmd in existing_commands:
        continue
    key_base = f"job_{cmd}"
    key, i = key_base, 2
    while key in jobs:
        key, i = f"{key_base}_{i}", i + 1
    jobs[key] = {
        "command": cmd,
        "label": meta["label"],
        "icon": meta["icon"],
        "icon_color": meta["icon_color"],
        "confirm": False,
        "detached_tab": True,
    }
    if meta.get("notify_phrase"):
        jobs[key]["notify_phrase"] = meta["notify_phrase"]
        jobs[key]["notify_delay_min"] = 1
    existing_commands.add(cmd)
    added.append(meta["label"])

if added:
    g["jobs"] = jobs
    cfg["__global__"] = g
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    for name in added:
        print(f"  Registered common job: {name}")
else:
    print("  No new common jobs (already registered)")
PY
}

prompt_initial_workspace() {
  echo "  A workspace is a directory you manage (typically a git repository)."
  echo "  More can be added later from the UI."
  echo ""
  info "  Scanning common dev directories for git repositories..."

  local repos_raw
  repos_raw="$(discover_git_repos)"
  if [ -z "$repos_raw" ]; then
    echo "  No git repositories found automatically."
    prompt_manual_workspace
    return 0
  fi

  local -a repos=()
  while IFS= read -r line; do
    [ -n "$line" ] && repos+=("$line")
  done <<< "$repos_raw"

  echo "  Found ${#repos[@]} git repositories:"
  local i
  for i in "${!repos[@]}"; do
    printf "    %2d) %s\n" "$((i + 1))" "${repos[$i]}"
  done
  echo ""
  echo "  Select: [a]ll, numbers (e.g. 1 3 5), [m]anual path, or Enter to skip"

  local sel
  read -rp "  > " sel

  local -a chosen=()
  case "$sel" in
    ""|[Nn])
      info "  Skipped (add workspaces from the UI later)"
      return 0 ;;
    [Aa])
      chosen=("${repos[@]}") ;;
    [Mm])
      prompt_manual_workspace
      return 0 ;;
    *)
      local tok
      for tok in $sel; do
        if [[ "$tok" =~ ^[0-9]+$ ]] && [ "$tok" -ge 1 ] && [ "$tok" -le "${#repos[@]}" ]; then
          chosen+=("${repos[$((tok - 1))]}")
        fi
      done ;;
  esac

  if [ ${#chosen[@]} -eq 0 ]; then
    warn "  No valid selection; skipped."
    return 0
  fi
  register_workspace_paths "$(printf '%s\n' "${chosen[@]}")"
}

tailscale_hostname() {
  local ts_bin
  ts_bin=$(command -v tailscale 2>/dev/null \
    || { [ -x /usr/local/bin/tailscale ] && echo /usr/local/bin/tailscale; } \
    || { [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ] && echo /Applications/Tailscale.app/Contents/MacOS/Tailscale; } \
    || echo "")
  [ -z "$ts_bin" ] && return
  "$ts_bin" status --json 2>/dev/null | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    print(d.get('Self', {}).get('DNSName', '').rstrip('.'))
except Exception:
    print('')
" 2>/dev/null
}

do_https_setup() {
  if ! command -v tailscale >/dev/null 2>&1; then
    warn "  Tailscale not found. Install from https://tailscale.com/download"
    return 1
  fi

  local hostname
  hostname=$(tailscale_hostname)
  if [ -z "$hostname" ]; then
    warn "  Could not determine Tailscale hostname (is the daemon running?)"
    return 1
  fi

  info "  Hostname: $hostname"
  mkdir -p certs
  local cert_path key_path
  cert_path="$SCRIPT_DIR/certs/$hostname.crt"
  key_path="$SCRIPT_DIR/certs/$hostname.key"

  info "  Issuing certificate via Tailscale (sudo required)..."
  if ! sudo tailscale cert --cert-file "$cert_path" --key-file "$key_path" "$hostname"; then
    warn "  Failed to obtain certificate"
    return 1
  fi
  sudo chown "$USER" "$cert_path" "$key_path" 2>/dev/null || true

  CERT="$cert_path" KEY="$key_path" python3 -c "
import json, os, pathlib
d = os.environ.get('ANY_CONSOLE_DATA_DIR', '').strip()
p = pathlib.Path(d).expanduser() / 'config.json' if d else pathlib.Path('config.json')
cfg = json.loads(p.read_text()) if p.is_file() else {}
g = cfg.get('__global__', {})
if not isinstance(g, dict):
    g = {}
g['ssl_certfile'] = os.environ['CERT']
g['ssl_keyfile'] = os.environ['KEY']
cfg['__global__'] = g
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + '\n', encoding='utf-8')
"
  info "  HTTPS configured: https://${hostname}:$(get_port)"

  if is_service_installed; then
    info "  Updating service with SSL env vars..."
    if is_macos; then
      # plist を作り直すと SSL env が反映され、bootstrap で再起動もされる。
      install_launchd
    else
      local service_dest="/etc/systemd/system/$SERVICE_NAME.service"
      generate_service_unit | sudo tee "$service_dest" > /dev/null
      sudo systemctl daemon-reload
      if is_service_active; then
        sudo systemctl restart "$SERVICE_NAME"
        info "  Service restarted"
      fi
    fi
  fi

  echo ""
  warn "  Note: cert expires in ~90 days. Re-run './any-console https-setup' to renew."
}

prompt_https_setup() {
  if ! command -v tailscale >/dev/null 2>&1; then
    echo "  Tailscale not detected — HTTPS setup will be skipped."
    echo "  HTTP works fine for trying any-console out from a browser."
    echo "  Install Tailscale and run './any-console https-setup' later to enable PWA install."
    return 0
  fi

  if [ -z "$(tailscale_hostname)" ]; then
    echo "  Tailscale daemon not reachable — skipping HTTPS setup."
    echo "  Run 'tailscale up' first, then './any-console https-setup'."
    return 0
  fi

  echo "  HTTPS is only required if you want to install any-console as a PWA on phones."
  echo "  HTTP works fine from any browser including phones — feel free to skip and try first."
  echo ""
  read -rp "Set up HTTPS via Tailscale now? [Y/n] " answer
  if [[ "$answer" =~ ^[Nn]$ ]]; then
    info "  Skipped (run './any-console https-setup' anytime to enable)"
    return 0
  fi
  do_https_setup
}

is_service_active() {
  if is_macos; then
    # sudo を避けるためプロセスの有無で判定する（単一アプリ前提）。
    pgrep -f "api.main" >/dev/null 2>&1
  else
    systemctl is-active "$SERVICE_NAME" >/dev/null 2>&1
  fi
}

is_service_installed() {
  if is_macos; then
    [ -f "$LAUNCHD_PLIST" ]
  else
    systemctl list-unit-files "$SERVICE_NAME.service" >/dev/null 2>&1 && \
      [ -f "/etc/systemd/system/$SERVICE_NAME.service" ]
  fi
}

# 常駐サービスの起動/停止/再起動を OS ごとに分岐する。
_launchd_domain() { echo "gui/$(id -u)"; }

start_service() {
  if is_macos; then
    launchctl bootstrap "$(_launchd_domain)" "$LAUNCHD_PLIST" 2>/dev/null || true
    launchctl kickstart "$(_launchd_domain)/$LAUNCHD_LABEL"
  else
    sudo systemctl start "$SERVICE_NAME"
  fi
}

stop_service() {
  if is_macos; then
    launchctl bootout "$(_launchd_domain)" "$LAUNCHD_PLIST" 2>/dev/null \
      || launchctl bootout "$(_launchd_domain)/$LAUNCHD_LABEL" 2>/dev/null || true
  else
    sudo systemctl stop "$SERVICE_NAME"
  fi
}

restart_service() {
  if is_macos; then
    launchctl kickstart -k "$(_launchd_domain)/$LAUNCHD_LABEL"
  else
    sudo systemctl restart "$SERVICE_NAME"
  fi
}

install_service() {
  if is_macos; then
    install_launchd
  else
    install_systemd
  fi
}

# セットアップが「実際に使える状態」かを確認する。
# 1) 依存が解決し api.main が import できるか（依存欠落・ビルド失敗をここで検出）
# 2) 既にサーバが動いていれば HTTP で応答するか（curl がある場合のみ）
verify_install() {
  local py port code
  py="$(venv_python)"

  if "$py" -c "import api.main" >/dev/null 2>&1; then
    info "  OK: dependencies resolve, api.main imports cleanly"
  else
    warn "  FAILED: api.main does not import. Inspect with:"
    warn "    $py -c 'import api.main'"
    return
  fi

  if command -v curl >/dev/null 2>&1; then
    port="$(get_port)"
    if code=$(curl -fsS -o /dev/null -w '%{http_code}' --max-time 3 "http://127.0.0.1:${port}/" 2>/dev/null); then
      info "  OK: server responding at http://localhost:${port}/ (HTTP $code)"
    else
      echo "  (server not started yet — it will answer on port ${port} once started)"
    fi
  fi
}

cmd_setup() {
  local non_interactive=0
  if [ "${1:-}" = "--non-interactive" ] || [ "${CI:-}" = "true" ]; then
    non_interactive=1
  fi

  echo ""
  info "=== any-console setup ==="
  echo ""
  echo "This will: check dependencies, install packages, build the UI,"
  echo "and ask you a few questions about bind / workspace / service."
  echo ""

  info "[1/7] Checking dependencies"
  check_deps
  local python_version
  python_version=$(check_python_version)
  info "  OK: Python $python_version, node $(node -v), git $(git --version | cut -d' ' -f3), tmux $(tmux -V | cut -d' ' -f2)"

  echo ""
  info "[2/7] Installing Python dependencies (.venv)"
  if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
  fi
  "$VENV_DIR/bin/pip" install --upgrade pip >/dev/null
  "$VENV_DIR/bin/pip" install -r requirements.txt
  # Push 通知の依存（pywebpush / http-ece）はネイティブビルドが必要で minimal な
  # ホストでは失敗しうる。失敗してもセットアップは止めず、push 無効で続行する。
  if ! "$VENV_DIR/bin/pip" install -r requirements-optional.txt; then
    warn "  Optional push-notification deps failed to build — continuing without push."
  fi

  echo ""
  info "[3/7] Installing Node.js dependencies"
  npm install

  echo ""
  info "[4/7] Building frontend"
  npm run build

  echo ""
  info "[5/7] Network bind configuration"
  if [ "$non_interactive" -eq 1 ]; then
    info "  Non-interactive: keeping default bind ($(get_host):$(get_port))"
  else
    prompt_bind_config
  fi

  echo ""
  info "[6/7] Initial workspace registration"
  if [ "$non_interactive" -eq 1 ]; then
    info "  Non-interactive: skipped (add workspaces from the UI later)"
  else
    prompt_initial_workspace
  fi

  echo ""
  info "[7/7] AI agent CLI detection"
  register_ai_agent_jobs "$non_interactive"

  local service_registered=0
  echo ""
  if [ "$non_interactive" -eq 1 ]; then
    info "Optional: service registration"
    info "  Non-interactive: skipped (register later via './any-console setup')"
  else
    if is_macos; then
      info "Optional: launchd service"
      echo "  Registers any-console as a LaunchAgent that starts at login."
      echo "  Recommended for an always-on Mac (e.g. a Mac mini server). Requires sudo."
      echo ""
      read -rp "Register a launchd service? [Y/n] " answer
    else
      info "Optional: systemd service"
      echo "  Registers any-console as a background service that starts on boot."
      echo "  Recommended for Linux hosts (skip for WSL — use './any-console run' instead)."
      echo ""
      read -rp "Register a systemd service? [Y/n] " answer
    fi
    if [[ ! "$answer" =~ ^[Nn]$ ]]; then
      install_service
      service_registered=1
    fi
  fi

  echo ""
  info "Optional: HTTPS via Tailscale"
  if [ "$non_interactive" -eq 1 ]; then
    info "  Non-interactive: skipped (run './any-console https-setup' later)"
  else
    prompt_https_setup
  fi

  echo ""
  info "[verify] Health check"
  verify_install

  echo ""
  info "=== Setup complete ==="
  echo ""
  if [ "$service_registered" -eq 1 ]; then
    info "Starting service..."
    start_service
    echo ""
    echo "Next steps:"
    echo "  Check status:  ./any-console status"
  else
    echo "Next steps:"
    echo "  Start in foreground: ./any-console run"
    echo "  (or register the service later via ./any-console setup)"
  fi

  if is_macos && [ "$service_registered" -eq 1 ]; then
    echo ""
    warn "macOS note: file access prompts"
    echo "  When any-console reads files under a TCC-protected folder (Desktop,"
    echo "  Documents, Downloads, iCloud Drive), macOS may show a one-time"
    echo "  permission dialog for the Python process. This cannot be suppressed"
    echo "  from code — grant access once via:"
    echo "    System Settings > Privacy & Security > Files and Folders"
    echo "    (or Full Disk Access) > add:"
    echo "    $(venv_python)"
    echo "  Then: ./any-console restart"
  fi
  local bind_host bind_port proto ts_host
  bind_host=$(get_host)
  bind_port=$(get_port)
  proto="http"
  has_https && proto="https"
  ts_host=$(tailscale_hostname 2>/dev/null || echo "")
  echo ""
  echo "Open:"
  if [ "$proto" = "https" ] && [ -n "$ts_host" ]; then
    echo "  https://${ts_host}:${bind_port}"
  else
    echo "  http://localhost:${bind_port}"
  fi
  echo ""
  local auth_token
  auth_token=$("$(venv_python)" -c "
import secrets, json, os, pathlib
d = os.environ.get('ANY_CONSOLE_DATA_DIR', '').strip()
base = pathlib.Path(d).expanduser() if d else pathlib.Path('data')
p = base / 'auth.json'
if not p.exists():
    token = secrets.token_urlsafe(24)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps({'token': token}) + '\n')
    print(token)
" 2>/dev/null)
  if [ -n "$auth_token" ]; then
    info "Auth token (save this — shown only once):"
    echo ""
    echo "  $auth_token"
    echo ""
    echo "How to use:"
    echo "  1. Start the service and open any-console in your browser"
    echo "  2. You will be prompted to enter a token on first visit"
    echo "  3. Paste the token above and sign in"
    echo "  Token is stored in data/auth.json — keep it secret."
    echo ""
    echo "(Settings > Workspaces to add more directories after signing in.)"
  else
    echo "Auth token already exists in data/auth.json."
    echo "(Settings > Workspaces to add more directories.)"
  fi
}

generate_service_unit() {
  local python_bin ssl_cert ssl_key env_lines=""
  python_bin="$(venv_python)"
  ssl_cert=$(get_ssl_certfile)
  ssl_key=$(get_ssl_keyfile)
  if [ -n "$ssl_cert" ]; then env_lines+="Environment=SSL_CERTFILE=$ssl_cert"$'\n'; fi
  if [ -n "$ssl_key" ];  then env_lines+="Environment=SSL_KEYFILE=$ssl_key"$'\n'; fi
  # サービスマネージャは setup 時のシェル環境を継承しないため、
  # 隔離ディレクトリ指定はユニット定義に永続化する
  # （空白入りパスでも切り詰められないよう systemd の引用規則で代入全体を囲む）
  if [ -n "${ANY_CONSOLE_DATA_DIR:-}" ]; then
    env_lines+="Environment=\"ANY_CONSOLE_DATA_DIR=$ANY_CONSOLE_DATA_DIR\""$'\n'
  fi
  cat <<UNIT
[Unit]
Description=any-console API
After=network.target

[Service]
User=$USER
WorkingDirectory=$SCRIPT_DIR
ExecStart=$python_bin -m api.main
${env_lines}KillMode=process
Restart=always
RestartSec=3
NoNewPrivileges=no
ProtectSystem=no
ProtectHome=no
MemoryMax=8G
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
UNIT
}

install_systemd() {
  local service_dest="/etc/systemd/system/$SERVICE_NAME.service"

  info "Registering systemd service..."
  generate_service_unit | sudo tee "$service_dest" > /dev/null
  sudo systemctl daemon-reload
  sudo systemctl enable "$SERVICE_NAME"
  info "systemd service registered"
}

generate_plist() {
  local python_bin ssl_cert ssl_key ssl_env=""
  python_bin="$(venv_python)"
  ssl_cert=$(get_ssl_certfile)
  ssl_key=$(get_ssl_keyfile)
  if [ -n "$ssl_cert" ] && [ -n "$ssl_key" ]; then
    ssl_env="    <key>SSL_CERTFILE</key>
    <string>$ssl_cert</string>
    <key>SSL_KEYFILE</key>
    <string>$ssl_key</string>
"
  fi
  # サービスマネージャは setup 時のシェル環境を継承しないため、
  # 隔離ディレクトリ指定は plist に永続化する（& < > を含むパスでも
  # plist が壊れないよう XML エスケープして埋め込む）
  if [ -n "${ANY_CONSOLE_DATA_DIR:-}" ]; then
    local data_dir_xml="$ANY_CONSOLE_DATA_DIR"
    data_dir_xml=${data_dir_xml//&/\&amp;}
    data_dir_xml=${data_dir_xml//</\&lt;}
    data_dir_xml=${data_dir_xml//>/\&gt;}
    ssl_env+="    <key>ANY_CONSOLE_DATA_DIR</key>
    <string>$data_dir_xml</string>
"
  fi
  # LaunchAgent はユーザーセッション内で動くため UserName 不要。
  # agent も最小 env のため PATH（Homebrew 含む）と HOME を明示する。
  # ProcessType=Interactive は必須: 未指定だと GUI セッション内のバックグラウンド
  # プロセスとして macOS の絞り込み（App Nap / QoS 降格）対象になり、tmux
  # subprocess がタイムアウトしてセッション消失系の誤判定を誘発する。
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LAUNCHD_LABEL</string>
  <key>WorkingDirectory</key>
  <string>$SCRIPT_DIR</string>
  <key>ProgramArguments</key>
  <array>
    <string>$python_bin</string>
    <string>-m</string>
    <string>api.main</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>$HOME</string>
$ssl_env  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>$LOG_FILE</string>
  <key>StandardErrorPath</key>
  <string>$LOG_FILE</string>
</dict>
</plist>
PLIST
}

install_launchd() {
  info "Registering launchd service..."

  # 旧 LaunchDaemon（/Library/LaunchDaemons/）が残っていれば移行撤去する。
  local old_plist="/Library/LaunchDaemons/$LAUNCHD_LABEL.plist"
  if [ -f "$old_plist" ]; then
    info "  Migrating from system daemon to user agent (sudo required)..."
    sudo launchctl bootout "system/$LAUNCHD_LABEL" 2>/dev/null || true
    sudo launchctl disable "system/$LAUNCHD_LABEL" 2>/dev/null || true
    sudo rm -f "$old_plist"
  fi

  mkdir -p "$SCRIPT_DIR/logs"
  mkdir -p "$(dirname "$LAUNCHD_PLIST")"
  generate_plist > "$LAUNCHD_PLIST"
  chmod 644 "$LAUNCHD_PLIST"
  # 既存ロードがあれば先に外す。disable 状態でも bootstrap できるよう enable を先に実行する。
  launchctl bootout "$(_launchd_domain)" "$LAUNCHD_PLIST" 2>/dev/null || true
  launchctl enable "$(_launchd_domain)/$LAUNCHD_LABEL"
  launchctl bootstrap "$(_launchd_domain)" "$LAUNCHD_PLIST"
  info "launchd agent registered (starts at login)"
}

cmd_update() {
  info "=== any-console update ==="

  if [ -n "$(git status --porcelain)" ]; then
    error "Uncommitted changes present. Commit or stash first."
  fi

  info "Fetching latest releases..."
  git fetch --tags --force origin

  local latest current
  latest=$(git tag -l --sort=-v:refname | head -1)
  current=$(git describe --tags --abbrev=0 2>/dev/null || echo "")
  if [ -z "$latest" ]; then
    error "No release tags found"
  fi
  if [ "$latest" = "$current" ]; then
    info "Already on the latest release ($current)"
    return
  fi

  info "Updating ${current:-(none)} -> $latest"
  git -c advice.detachedHead=false checkout "$latest"

  info "Updating dependencies..."
  if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
  fi
  "$VENV_DIR/bin/pip" install -r requirements.txt
  if ! "$VENV_DIR/bin/pip" install -r requirements-optional.txt; then
    warn "  Optional push-notification deps failed to build — continuing without push."
  fi
  npm install

  info "Building frontend..."
  npm run build

  if is_service_installed && is_service_active; then
    info "Restarting service..."
    restart_service
    info "Service restarted"
  fi

  info "=== Update complete ($(get_version)) ==="
}

cmd_start() {
  start_service
  info "Service started"
}

cmd_stop() {
  stop_service
  info "Service stopped"
}

cmd_restart() {
  restart_service
  info "Service restarted"
}

cmd_status() {
  echo -e "${BOLD}any-console${NC}"
  echo ""

  echo -n "  Service: "
  if is_service_installed; then
    if is_service_active; then
      echo -e "${GREEN}running${NC}"
    else
      echo -e "${RED}stopped${NC}"
    fi
  else
    echo -e "${YELLOW}not registered${NC}"
  fi

  local proto="http" ts_host url
  has_https && proto="https"
  ts_host=$(tailscale_hostname 2>/dev/null || echo "")
  if [ "$proto" = "https" ] && [ -n "$ts_host" ]; then
    url="${proto}://${ts_host}:$(get_port)"
  else
    url="${proto}://localhost:$(get_port)"
  fi
  echo "  Version: $(get_version)"
  echo "  URL: $url"
  echo "  Directory: $SCRIPT_DIR"
}

cmd_logs() {
  if is_macos; then
    if [ ! -f "$LOG_FILE" ]; then
      warn "No log file yet at $LOG_FILE (start the service first)."
      return 0
    fi
    tail -n 50 -f "$LOG_FILE"
  else
    journalctl -u "$SERVICE_NAME" -f --no-pager -n 50
  fi
}

cmd_uninstall() {
  echo ""
  info "=== any-console uninstall ==="
  echo ""
  echo "This will remove the any-console service registration."
  echo ""
  read -rp "Continue? [y/N] " answer
  [[ "$answer" =~ ^[Yy]$ ]] || { echo "Aborted."; return; }

  if is_service_installed; then
    info "Stopping and removing service..."
    if is_macos; then
      launchctl bootout "$(_launchd_domain)" "$LAUNCHD_PLIST" 2>/dev/null || true
      launchctl disable "$(_launchd_domain)/$LAUNCHD_LABEL" 2>/dev/null || true
      rm -f "$LAUNCHD_PLIST"
      # 旧 system daemon が残っていれば併せて撤去する。
      local old_plist="/Library/LaunchDaemons/$LAUNCHD_LABEL.plist"
      if [ -f "$old_plist" ]; then
        sudo launchctl bootout "system/$LAUNCHD_LABEL" 2>/dev/null || true
        sudo rm -f "$old_plist"
      fi
      # launchd の bootout で止まらなかった残存プロセスを終了する。
      pkill -f "api.main" 2>/dev/null || true
      info "  launchd agent removed"
    else
      sudo systemctl stop "$SERVICE_NAME" 2>/dev/null || true
      sudo systemctl disable "$SERVICE_NAME" 2>/dev/null || true
      sudo rm -f "/etc/systemd/system/$SERVICE_NAME.service"
      sudo systemctl daemon-reload
      info "  systemd service removed"
    fi
  else
    info "No service registered — skipping"
  fi

  echo ""
  # ANY_CONSOLE_DATA_DIR 設定時はそのディレクトリが実データ（誤って既定側を消さない）
  local data_dir="${ANY_CONSOLE_DATA_DIR:-$SCRIPT_DIR/data}"
  echo "Remove ${data_dir}? (auth token, config, push subscriptions)"
  read -rp "[y/N] " answer
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    rm -rf "$data_dir"
    info "  ${data_dir} removed"
  else
    info "  ${data_dir} kept"
  fi

  echo ""
  echo "Remove .venv/ and node_modules/? (can be reinstalled with setup)"
  read -rp "[y/N] " answer
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    rm -rf "$SCRIPT_DIR/.venv" "$SCRIPT_DIR/node_modules"
    info "  .venv/ and node_modules/ removed"
  else
    info "  .venv/ and node_modules/ kept"
  fi

  echo ""
  info "Uninstall complete."
  echo "The any-console directory itself is not removed."
  echo "To fully remove, delete: $SCRIPT_DIR"
}

cmd_run() {
  check_deps
  check_python_version >/dev/null
  local proto="http" ts_host url
  if has_https; then
    export SSL_CERTFILE="$(get_ssl_certfile)"
    export SSL_KEYFILE="$(get_ssl_keyfile)"
    proto="https"
  fi
  ts_host=$(tailscale_hostname 2>/dev/null || echo "")
  if [ "$proto" = "https" ] && [ -n "$ts_host" ]; then
    url="${proto}://${ts_host}:$(get_port)"
  else
    url="${proto}://localhost:$(get_port)"
  fi
  info "Starting any-console in the foreground (Ctrl+C to stop)"
  echo "  URL: $url"
  exec "$(venv_python)" -m api.main
}

cmd_https_setup() {
  info "=== HTTPS setup ==="
  do_https_setup
}

cmd_version() {
  echo "any-console $(get_version)"
}

usage() {
  echo -e "${BOLD}Usage:${NC} ./any-console <command>"
  echo ""
  echo "Commands:"
  echo "  setup        Initial setup (install deps + build + optional service register)"
  echo "               --non-interactive: skip prompts, use defaults (also auto-detected via CI=true)"
  echo "  update       Update to latest (git pull + deps + build + service restart)"
  echo "  start        Start service (systemd / launchd)"
  echo "  stop         Stop service (systemd / launchd)"
  echo "  restart      Restart service (systemd / launchd)"
  echo "  status       Show service state, URL, version"
  echo "  logs         Tail service logs (journalctl / log file)"
  echo "  run          Run in foreground (no service; any OS)"
  echo "  https-setup  Issue / renew a Tailscale HTTPS cert (required for PWA install)"
  echo "  uninstall    Remove service registration and optionally clean up files"
  echo "  version      Print version"
}

# インストール済みサービス定義に永続化された隔離ディレクトリを環境へ引き継ぐ。
# `ANY_CONSOLE_DATA_DIR=... ./any-console setup` で登録した後、env なしの通常呼び出し
# （https-setup / uninstall / ユニット再生成など）が既定パスへ戻ってしまわないようにする。
adopt_installed_data_dir() {
  [ -n "${ANY_CONSOLE_DATA_DIR:-}" ] && return
  local unit="/etc/systemd/system/$SERVICE_NAME.service" value=""
  if [ -f "$unit" ]; then
    value=$(sed -n 's/^Environment="ANY_CONSOLE_DATA_DIR=\(.*\)"$/\1/p' "$unit" | head -n1)
  elif [ -f "$LAUNCHD_PLIST" ]; then
    value=$(PLIST="$LAUNCHD_PLIST" python3 -c "
import os, plistlib
with open(os.environ['PLIST'], 'rb') as f:
    d = plistlib.load(f)
print(d.get('EnvironmentVariables', {}).get('ANY_CONSOLE_DATA_DIR', ''))
" 2>/dev/null)
  fi
  if [ -n "$value" ]; then
    export ANY_CONSOLE_DATA_DIR="$value"
  fi
}

command="${1:-}"

adopt_installed_data_dir

case "$command" in
  setup)   cmd_setup "${2:-}" ;;
  update)  cmd_update ;;
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  logs)    cmd_logs ;;
  run)         cmd_run ;;
  https-setup) cmd_https_setup ;;
  uninstall)   cmd_uninstall ;;
  version)     cmd_version ;;
  *)       usage ;;
esac
