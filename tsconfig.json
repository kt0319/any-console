{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "baseUrl": "."
  },
  "include": ["ui/env.d.ts", "ui/**/*.js", "ui/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "ui/sw.js",
    "ui/vue-main.js",
    "ui/app-bridge.js"
  ]
}
