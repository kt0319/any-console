{
  "ws_000000000001": {
    "name": "my-project",
    "path": "/path/to/your-project",
    "icon": "mdi-folder",
    "icon_color": "#1e88e5",
    "jobs": {
      "job_000000000001": {
        "command": "npm test",
        "label": "Test",
        "icon": "mdi-flask",
        "icon_color": "#43a047",
        "confirm": false
      },
      "job_000000000002": {
        "command": "npm run build",
        "label": "Build",
        "icon": "mdi-package-variant",
        "icon_color": "#fb8c00",
        "confirm": true
      },
      "job_000000000003": {
        "command": "npm run e2e",
        "label": "E2E Test",
        "icon": "mdi-test-tube",
        "confirm": false
      }
    }
  },
  "ws_000000000002": {
    "name": "dotfiles",
    "path": "/path/to/your-dotfiles",
    "icon": "mdi-cog",
    "icon_color": "#8e24aa"
  },
  "__global__": {
    "config_version": 4,
    "snippets": [
      {
        "label": "git status",
        "command": "git status"
      },
      {
        "label": "git log",
        "command": "git log --oneline -10"
      }
    ],
    "workspace_order": [
      "ws_000000000001",
      "ws_000000000002"
    ],
    "editor": {
      "url_template": "vscode://vscode-remote/ssh-remote+{user}@{host}{workspace_path}"
    },
    "recent_jobs": []
  }
}
