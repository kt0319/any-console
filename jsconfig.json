{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "strictNullChecks": true,
    "ignoreDeprecations": "5.0",
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "baseUrl": "."
  },
  "include": ["ui/**/*.js"],
  "exclude": [
    "node_modules",
    "dist",
    "ui/sw.js",
    "ui/vue-main.js",
    "ui/app-bridge.js"
  ]
}
